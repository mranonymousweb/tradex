# Google reCAPTCHA v3
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your-recaptcha-site-key
RECAPTCHA_SECRET_KEY=your-recaptcha-secret-key

#/
# app name
#/
NEXT_PUBLIC_APP_NAME=aryagostaran


# Base URL
# backend api
NEXT_PUBLIC_API_BACKEND_URL=https://example.tarahiweb.net

# user panel
NEXT_PUBLIC_API_FRONTEND_URL=https://localhost:3000
NEXT_PUBLIC_DOMAIN_PANEL=localhost

#WebSocket domain
NEXT_PUBLIC_SOCKET_PUBLIC=wss://wss.example.net

#/
# LANGUAGE 
# fa = persian  
# en = English  
# ar = Arabic  
# es = Spanish  
# de = German  
# ch = Chinese  
# ru = Russian  
# tu = Turkish  
#/
NEXT_PUBLIC_DEFAULT_LANGUAGE=fa

#/
# Create Generate SECRET_KEY 
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#/
SECRET_KEY=REPLACE_ME_RUN_THE_COMMAND_ABOVE_TO_GENERATE_A_NEW_KEY

#/
# development
# production
#/
MODE_ENV=development


#/
# enabled navigator sidebar
# true or false
#/
# trade futures
NEXT_PUBLIC_ENABLE_FUTURES=true
# trade spot
NEXT_PUBLIC_ENABLE_SPOT=true


#/
# hours per day session
#/

HOURS_PER_DAY=168 # 7 days